# Copy this file to .env for local development.
# Do not commit .env or any real API keys.

APP_ENV=development
DATABASE_URL=sqlite:////home/work/workproject2/project/data/simulation.db

# OpenAI-compatible chat model configuration.
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512
LLM_ENABLE_THINKING=false

# Optional per-agent overrides. Empty values fall back to LLM_*.
AGENT_ORCHESTRATOR_MODEL=
AGENT_ORDER_MANAGER_MODEL=
AGENT_PROJECT_IDENTIFIER_MODEL=
AGENT_RAG_RETRIEVER_MODEL=
AGENT_QUEUE_SCHEDULER_MODEL=
AGENT_EQUIPMENT_MONITOR_MODEL=
AGENT_EXCEPTION_ANALYZER_MODEL=
AGENT_EXCEPTION_ANALYZER_TEMPERATURE=0.2
AGENT_EXCEPTION_ANALYZER_MAX_TOKENS=1024
AGENT_EXCEPTION_ANALYZER_ENABLE_THINKING=false

# OpenAI-compatible embedding configuration for FAISS/RAG.
# When EMBEDDING_API_KEY is empty, the project uses deterministic local embeddings.
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v3
RAG_INDEX_DIR=/home/work/workproject2/project/rag/index

# Synthetic operations constraints used by the scheduler.
OPERATIONS_CONSTRAINTS_PATH=/home/work/workproject2/project/data/scenario_synthetic_center/operations_constraints.json

# MCP stdio server. The adapter type is a switch label for the tool source.
MCP_ADAPTER_TYPE=simulation
MCP_SERVER_COMMAND=/root/anaconda3/envs/agent-learning/bin/python
MCP_SERVER_ARGS=-m mcp_server.simulation_server
MCP_SERVER_CWD=/home/work/workproject2/project
