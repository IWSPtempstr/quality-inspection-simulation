AI_SERVICE_ENVIRONMENT=production
AI_SERVICE_LOG_LEVEL=INFO
AI_SERVICE_PROMPT_DIRECTORY=/app/prompts
AI_SERVICE_LLM_TIMEOUT_SECONDS=10
AI_SERVICE_DEFAULT_MODEL=disabled
AI_SERVICE_MEMORY_RECENT_TTL_SECONDS=86400
AI_SERVICE_MEMORY_SUMMARY_TTL_SECONDS=604800
AI_SERVICE_MEMORY_MAX_TURNS=8
AI_SERVICE_MEMORY_MAX_TOKENS=6000
AI_SERVICE_SERVICE_BEARER_TOKEN_FILE=/run/secrets/internal_service_token
