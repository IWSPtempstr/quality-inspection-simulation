# Copy outside the repository and replace example.invalid values.
APP_ENV=production
HTTP_ADDR=:8080
PUBLIC_APP_URL=https://scheduling.example.invalid
DATABASE_URL_FILE=/run/secrets/api_database_url
RABBITMQ_URL_FILE=/run/secrets/api_rabbitmq_url
REDIS_URL_FILE=/run/secrets/api_redis_url
OIDC_ISSUER_URL=https://id.example.invalid/realms/detection-center
OIDC_CLIENT_ID=detection-scheduling-workbench
OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
OIDC_REDIRECT_URL=https://scheduling.example.invalid/api/v1/auth/callback
OIDC_CENTER_CLAIM=center_id
OIDC_ROLES_CLAIM=roles
OIDC_SCOPES=openid profile email
SESSION_TTL_SECONDS=28800
INTERNAL_SERVICE_TOKEN_FILE=/run/secrets/internal_service_token
SCHEDULER_SERVICE_BEARER_TOKEN_FILE=/run/secrets/scheduler_service_bearer_token
SCHEDULER_CALLBACK_SERVICE_TOKEN_FILE=/run/secrets/scheduler_callback_service_token
PARTNER_SCHEDULE_URL=https://partner.example.invalid
PARTNER_SCHEDULE_CREDENTIAL_FILE=/run/secrets/partner_schedule_credential
NOTIFICATION_WEBHOOK_URL=https://notify.example.invalid/webhooks/detection-center
NOTIFICATION_WEBHOOK_CREDENTIAL_FILE=/run/secrets/notification_webhook_credential
AI_SERVICE_URL=http://ai-service:8080
