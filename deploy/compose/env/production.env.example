# Copy this file outside the repository (for example /etc/detection-center/compose.env)
# and replace every example hostname and filesystem path before deployment.
COMPOSE_PROJECT_NAME=detection-center
PUBLIC_HOSTNAME=scheduling.example.invalid
ACME_EMAIL=operations@example.invalid
DATA_DIR=/srv/detection-center/data
CERTS_DIR=/srv/detection-center/certificates
ACME_WEBROOT_DIR=/srv/detection-center/acme-webroot
SECRETS_DIR=/srv/detection-center/secrets
API_GO_ENV_FILE=/etc/detection-center/api-go.prod.env
AI_SERVICE_ENV_FILE=/etc/detection-center/ai-py.prod.env
SCHEDULER_ENV_FILE=/etc/detection-center/scheduler-py.prod.env
POSTGRES_ENV_FILE=/etc/detection-center/postgres.prod.env
RABBITMQ_ENV_FILE=/etc/detection-center/rabbitmq.prod.env
CHROMA_ENV_FILE=/etc/detection-center/chroma.prod.env
POSTGRES_IMAGE=postgres:16-alpine
RABBITMQ_IMAGE=rabbitmq:4-management-alpine
REDIS_IMAGE=redis:7-alpine
CHROMA_IMAGE=chromadb/chroma:0.5.23
NGINX_IMAGE=nginx:1.27-alpine
CERTBOT_IMAGE=certbot/certbot:v2.11.0
