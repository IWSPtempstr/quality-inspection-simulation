# Copy this file to a local, untracked environment file before running a later service task.
SCHEDULER_ENVIRONMENT=development
SCHEDULER_SERVICE_BEARER_TOKEN=local-development-token
SCHEDULER_CALLBACK_SERVICE_TOKEN=local-callback-token
SCHEDULER_CALLBACK_BASE_URL=http://api-go.internal
SCHEDULER_REQUEST_QUEUE=scheduler.requests
SCHEDULER_RESULT_QUEUE=scheduler.results
SCHEDULER_SOLVER_TIME_LIMIT_SECONDS=30
SCHEDULER_QUEUE_SIZE_PROTECTION_LIMIT=100
